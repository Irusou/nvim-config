{
  "main": {
    "prefix": "main",
    "body": ["int main(int argc, char **argv) {", "\t$1", "\treturn 0;", "}"]
  },
  "include": {
    "prefix": "inc",
    "body": ["#include <${1:stdio}.h>"]
  },
  "include local": {
    "prefix": "incl",
    "body": ["#include \"${1:header}.h\""]
  },
  "printf": {
    "prefix": "pf",
    "body": ["printf(\"${1:%d}\\n\", $2);"]
  },
  "for": {
    "prefix": "for",
    "body": ["for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {", "\t$3", "}"]
  },
  "while": {
    "prefix": "wh",
    "body": ["while (${1:cond}) {", "\t$2", "}"]
  },
  "struct": {
    "prefix": "st",
    "body": ["typedef struct {", "\t$2", "} ${1:Name};"]
  },
  "malloc": {
    "prefix": "mal",
    "body": [
      "${1:int} *${2:ptr} = malloc(${3:n} * sizeof(${1:int}));",
      "if (${2:ptr} == NULL) {",
      "\t$4",
      "}"
    ]
  },
  "header guard": {
    "prefix": "guard",
    "body": [
      "#ifndef ${1:HEADER_H}",
      "#define ${1:HEADER_H}",
      "",
      "$2",
      "",
      "#endif /* ${1:HEADER_H} */"
    ]
  }
}
