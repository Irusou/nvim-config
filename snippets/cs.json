{
  "Console.WriteLine": {
    "prefix": "cw",
    "body": ["Console.WriteLine($1);"]
  },
  "property": {
    "prefix": "prop",
    "body": ["public ${1:string} ${2:Name} { get; set; }"]
  },
  "constructor": {
    "prefix": "ctor",
    "body": ["public ${1:ClassName}(${2})", "{", "\t$3", "}"]
  },
  "class": {
    "prefix": "cls",
    "body": ["public class ${1:Name}", "{", "\t$2", "}"]
  },
  "interface": {
    "prefix": "intf",
    "body": ["public interface I${1:Name}", "{", "\t$2", "}"]
  },
  "method": {
    "prefix": "meth",
    "body": ["public ${1:void} ${2:Name}(${3})", "{", "\t$4", "}"]
  },
  "async method": {
    "prefix": "ameth",
    "body": [
      "public async Task${1:<${2:T}>} ${3:Name}Async(${4})",
      "{",
      "\t$5",
      "}"
    ]
  },
  "foreach": {
    "prefix": "fe",
    "body": ["foreach (var ${1:item} in ${2:collection})", "{", "\t$3", "}"]
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:length}; ${1:i}++)",
      "{",
      "\t$3",
      "}"
    ]
  },
  "try/catch": {
    "prefix": "tc",
    "body": [
      "try",
      "{",
      "\t$1",
      "}",
      "catch (${2:Exception} ${3:ex})",
      "{",
      "\t$4",
      "}"
    ]
  },
  "using": {
    "prefix": "us",
    "body": ["using (var ${1:x} = ${2:new Thing()})", "{", "\t$3", "}"]
  },
  "switch": {
    "prefix": "sw",
    "body": [
      "switch (${1:value})",
      "{",
      "\tcase ${2:x}:",
      "\t\t$3",
      "\t\tbreak;",
      "\tdefault:",
      "\t\tbreak;",
      "}"
    ]
  }
}
